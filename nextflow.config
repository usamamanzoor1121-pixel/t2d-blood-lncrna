/*
 * Nextflow configuration — T2D Blood lncRNA Meta-Analysis Pipeline
 *
 * NOTE: main.nf/this config were written to formalize the pipeline's process
 * graph but were not executed end-to-end via the Nextflow engine in this
 * session — the sandboxed WSL environment's available Java (11) is below
 * Nextflow's minimum requirement (17+), and installing a newer JDK stalled
 * on this session's environment. The underlying analysis IS fully executed
 * and validated (see RESULTS_SUMMARY.md) by running the same five scripts
 * directly in the order below. To actually run via Nextflow: install a
 * JDK >=17 (`sudo apt install openjdk-17-jre-headless`), install Nextflow
 * (`curl -s https://get.nextflow.io | bash`), then `./nextflow run main.nf`.
 */

process {
    executor = 'local'
    cpus = 2
    memory = '4 GB'
}

executor {
    name = 'local'
    cpus = 6
}

report {
    enabled = true
    file = "data/pipeline_report.html"
}

timeline {
    enabled = true
    file = "data/pipeline_timeline.html"
}
